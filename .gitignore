# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment
.env
*.local.yaml

# Data - raw downloads (823 MB) and intermediates stay out. The unified dataset and
# the difficulty labels are committed so Phases 4-9 and the dashboard run from a
# clone without re-downloading seven sources.
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep
!data/**/README.md
!data/processed/unified.parquet
!data/processed/difficulty_labels.parquet

# Artifacts - logs and shards stay out. The 4,000 traces (5.5 MB) and the trained
# policies are committed: they are what every reported number is computed from, and
# regenerating the traces needs a GPU.
artifacts/traces/**
artifacts/models/**
artifacts/logs/**
!artifacts/**/.gitkeep
!artifacts/traces/traces.parquet
!artifacts/traces/trace_summary.parquet
!artifacts/traces/transitions.parquet
!artifacts/models/stopping_policy.pt
!artifacts/models/behaviour_cloning.joblib
!artifacts/models/difficulty_clf.joblib

# Results are small and worth keeping, but not the raw plots dump
artifacts/results/**/*.png
artifacts/results/**/*.pdf

# Experiment tracking
mlruns/
wandb/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Office lock/temp files
~$*

# Large regenerable result bundles
phase3_results.zip
*.zip

# Course/report deliverables (kept locally, not tracked)
*.pptx
*.docx

.coverage
